# Local experiments and build products
.tmp/
build/
sdk/

# Toolchain build artifacts
toolchain/lib/*.o
toolchain/lib/*.a

# XNU build tree
upstream/xnu/BUILD/

# Editor / OS noise
.DS_Store
*.swp

# Generated DriverKit IIG implementations
upstream/xnu/iokit/DriverKit/*.iig.cpp
upstream/xnu/iokit/Tests/TestServices/TestDextRematch.iig.cpp

# Python bytecode
__pycache__/

# Loader and kernel build products (the sources are submodule content and
# patches, never binaries).
upstream/xnu-loader/build/
upstream/xnu-loader/.cache/

# Anything extracted from macOS stays outside the repository, but guard against
# accidentally committing it from a checkout that uses in-tree paths.
*.dylib
*.kext/
*.kernelcache
kernelcache*
*.ipsw
*.dmg
*.hfs
*.iso
*.img
*.fd
