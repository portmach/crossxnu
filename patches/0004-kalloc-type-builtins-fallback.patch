+#if __has_builtin(__builtin_xnu_type_summary)
+#define __XNU_TYPE_SUMMARY(type) __builtin_xnu_type_summary(type)
+#else
+/*
+ * Upstream clang does not implement Apple's type-summary builtin.
+ *
+ * Approximate it: a top-level pointer is a pointer granule; everything
+ * else is treated as data+padding.  This keeps OSData/OSAllocation
+ * static_asserts working, but does not inspect pointers nested in
+ * aggregates.  See docs/compatibility.md for the remaining ABI gap.
+ */
+#ifdef __cplusplus
+#define __XNU_TYPE_SUMMARY(type) (__is_pointer(type) ? 2u : 5u)
+#else
+#define __XNU_TYPE_SUMMARY(type) 5u
+#endif
+#endif
+
 #define KT_SUMMARY_GRANULES(type) \
-	(__builtin_xnu_type_summary(type) & KT_SUMMARY_MASK_TYPE_BITS)
