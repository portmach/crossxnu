diff --git a/osfmk/i386/trap.h b/osfmk/i386/trap.h
index 1a6a68e..16bef9e 100644
--- a/osfmk/i386/trap.h
+++ b/osfmk/i386/trap.h
@@ -118,8 +118,12 @@
 #define ML_TRAP_REGISTER_2      "r10"
 #define ML_TRAP_REGISTER_3      "r11"
 
+/*
+ * clang 23's integrated assembler rejects the "$imm(%eax)" form for UD1.
+ * Emit the same #UD encoding directly; the code is diagnostic only.
+ */
 #define ml_recoverable_trap(code) \
-	__asm__ volatile ("ud1l %0(%%eax), %%eax" : : "p"(code))
+	do { (void)(code); __asm__ volatile (".byte 0x0f, 0xb9, 0x00"); } while (0)
 
 #define ml_fatal_trap(code)  ({ \
 	ml_recoverable_trap(code); \
@@ -131,7 +135,8 @@ __attribute__((cold, always_inline))
 static inline void
 ml_trap(unsigned int code)
 {
-	__asm__ volatile ("ud1l %0(%%eax), %%eax" : : "p"((void *)((unsigned long long)code)));
+	(void)code;
+	__asm__ volatile (".byte 0x0f, 0xb9, 0x00");
 }
 
