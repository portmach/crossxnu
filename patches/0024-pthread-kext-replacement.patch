+/* from <pthread/workqueue_syscalls.h> */
+#define CROSSXNU_WQ_KEVENT_LIST_LEN    16
+#define CROSSXNU_WQ_KEVENT_DATA_SIZE   (32 * 1024)
+
+/*
+ * crossxnu: the per-upcall scratch area on a workqueue thread's stack.
+ *
+ * kevent_workq_internal() (see the comment above it in kern_event.c) needs
+ * three things in the task's address space:
+ *
+ *   - data_out:   a buffer for the auxiliary data of the events
+ *                 (mach messages etc.), WQ_KEVENT_DATA_SIZE bytes;
+ *   - eventlist:  an array of WQ_KEVENT_LIST_LEN struct kevent_qos_s;
+ *   - a place for the kqueue id, which the kernel copies out with copyout()
+ *                 at `eventlist - sizeof(kqueue_id_t)`, i.e. the last 8 bytes
+ *                 of the data buffer.
+ *
+ * The documented stack layout is
+ *
+ *     | user stack | data avail | nevents | pthread_self() |
+ *                  ^            ^
+ *              data_out     eventlist
+ *
+ * and libpthread finds the kqueue id as `(kqueue_id_t *)eventlist - 1`, so the
+ * event array has to be *above* the data buffer and *below* the pthread
+ * struct (which sits at stackaddr).
+ */
+struct crossxnu_wq_scratch {
+	user_addr_t data_out;       /* [data_out, data_out + DATA_SIZE) */
+	user_addr_t eventlist;      /* kqid at eventlist - 8; array above it */
+	user_addr_t stack_pointer;  /* where the thread starts executing */
+};
+
+static void
+crossxnu_wq_scratch_layout(user_addr_t stackaddr, struct crossxnu_wq_scratch *sc)
+{
+	user_addr_t evsz = CROSSXNU_WQ_KEVENT_LIST_LEN * sizeof(struct kevent_qos_s);
+
+	sc->eventlist = stackaddr - evsz;
+	sc->data_out = sc->eventlist - CROSSXNU_WQ_KEVENT_DATA_SIZE;
+	sc->stack_pointer = (sc->data_out - 128) & ~(user_addr_t)0xf;
+}
+
+static int
+crossxnu_workq_handle_stack_events(proc_t p, thread_t th,
+    __unused vm_map_t map, user_addr_t stackaddr,
+    __unused mach_port_name_t kport, user_addr_t events,
+    int nevents, int upcall_flags)
+{
+	struct uthread *uth = get_bsdthread_info(th);
+	struct crossxnu_wq_scratch sc;
+	user_size_t data_available = CROSSXNU_WQ_KEVENT_DATA_SIZE;
+	int32_t     retval = 0;
+	int         error;
+
+	/*
+	 * crossxnu: the thread has come back from userspace with the kevents it
+	 * processed.  Hand them to the kqueue/workloop it is bound to and, with
+	 * KEVENT_FLAG_PARKING, let the kevent subsystem park it:
+	 *
+	 *  - kevent_workq_internal() either blocks the thread in the kernel
+	 *    (and we never return from here), or
+	 *  - it returns an error, or
+	 *  - it returns 0 with the thread unbound, and workq_thread_return()
+	 *    parks it right after us.
+	 *
+	 * `events` is libpthread's `self->arg`: an array of struct kevent_qos_s
+	 * on this thread's stack.  libdispatch may have advanced it, so keep the
+	 * caller's value -- but make sure the kernel has somewhere to copy the
+	 * kqueue id to (it writes at `events - sizeof(kqueue_id_t)`).
+	 */
+	crossxnu_wq_scratch_layout(stackaddr, &sc);
+
+	if (events == 0 || nevents < 0) {
+		events = sc.eventlist;
+		nevents = 0;
+	}
+
+	error = kevent_workq_internal(p, 0, 0, events, nevents, sc.data_out,
+	    &data_available, KEVENT_FLAG_STACK_DATA | KEVENT_FLAG_IMMEDIATE |
+	    KEVENT_FLAG_PARKING, &retval);
+
+	if (error != 0) {
+		printf("crossxnu: workq_handle_stack_events: pid=%d error=%d "
+		    "(kqr=%p nevents=%d flags=0x%x)\n", proc_getpid(p), error,
+		    (void *)uth->uu_kqr_bound, nevents, upcall_flags);
+	}
+
+	return error;
+}
+
+/*
+ * crossxnu: geometry of a workqueue thread stack.
+ *
+ * The pthread kext (which we replace here) and libpthread have a private
+ * agreement about the layout of the stack it hands to a workqueue thread.
+ * libpthread's side of it is visible in _pthread_wqthread_setup():
+ *
+ *     void *stackaddr = self;                              // pthread struct
+ *     size_t stacksize = self - stacklowaddr;
+ *     _pthread_struct_init(self, &_pthread_attr_default, stackaddr, stacksize,
+ *             PTHREAD_ALLOCADDR(stackaddr, stacksize),
+ *             PTHREAD_ALLOCSIZE(stackaddr, stacksize));
+ *
+ * with
+ *
+ *     #define PTHREAD_ALLOCADDR(a, s) ((a - s) - page_size)
+ *     #define PTHREAD_ALLOCSIZE(a, s) ((round_page(a) + PTHREAD_SIZE) - ALLOCADDR(a, s))
+ *
+ * so the mapping must be
+ *
+ *     base                        vm_allocate() result
+ *     base + page_size         stacklowaddr (the guard page lives below it)
+ *     ...
+ *     stackaddr                   top of the usable stack; `self` points here
+ *     stackaddr + pthsize         end of the mapping
+ *
+ * The pthread struct itself is *above* the stack; the stack grows down from
+ * stackaddr, so the very first push lands inside the stack.
+ *
+ * PTHREAD_SIZE is what libpthread passes to bsdthread_register() as `pthsize`,
+ * which is where the size of the struct reservation comes from.
+ */
+/* from <pthread/workqueue_syscalls.h>; that header is only visible with
+ * __PTHREAD_EXPOSE_INTERNALS__, which we do not want to define here */
+#define CROSSXNU_WQ_FLAG_THREAD_TSD_BASE_SET    0x00200000
+#define CROSSXNU_WQ_SETUP_EXIT_THREAD           8
+
+
+#define CROSSXNU_WQ_STACK_SIZE  (512 * 1024)
+
+
+static void
+crossxnu_wq_stack_geometry(proc_t p, vm_size_t *stack_size, vm_size_t *wq_total)
+{
+	vm_size_t pthsize;
+
+	/* libpthread's PTHREAD_SIZE; bsdthread_register() stores it in the proc */
+	pthsize = (vm_size_t)proc_get_pthsize(p);
+	if (pthsize < page_size) {
+		pthsize = page_size;
+	}
+	pthsize = round_page(pthsize);
+
+	*stack_size = CROSSXNU_WQ_STACK_SIZE;
+	*wq_total = page_size + CROSSXNU_WQ_STACK_SIZE + pthsize;
+}
+
+static int
+crossxnu_workq_create_threadstack(proc_t p, vm_map_t vmap,
+    mach_vm_offset_t *out_addr)
+{
+	vm_offset_t    addr = 0;
+	vm_size_t      stack_size, wq_total;
+	kern_return_t  kr;
+
+	crossxnu_wq_stack_geometry(p, &stack_size, &wq_total);
+
+	kr = vm_allocate(vmap, &addr, wq_total, VM_FLAGS_ANYWHERE);
+	if (kr != KERN_SUCCESS) {
+		printf("crossxnu: workq_create_threadstack: vm_allocate(0x%lx) failed kr=%d\n",
+		    (unsigned long)wq_total, kr);
+		return (int)kr;
+	}
+
+	*out_addr = (mach_vm_offset_t)(addr + page_size + stack_size);
+	printf("crossxnu: workq_create_threadstack: base=0x%llx top=0x%llx size=0x%llx\n",
+	    (unsigned long long)addr, (unsigned long long)*out_addr,
+	    (unsigned long long)wq_total);
+	return 0;
+}
