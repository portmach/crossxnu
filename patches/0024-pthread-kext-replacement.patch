+static int
+crossxnu_bsdthread_terminate(struct proc *p, user_addr_t stackaddr,
+    size_t size, __unused uint32_t kthport, __unused uint32_t sem,
+    __unused int32_t *retval)
+{
+	vm_map_t map = get_task_map(proc_task(p));
+	thread_t th = current_thread();
+
+	/*
+	 * crossxnu: this is the end of pthread_exit()/_pthread_terminate().
+	 *
+	 * libpthread calls __bsdthread_terminate(freeaddr, freesize, kport, sema)
+	 * and then does
+	 *
+	 *     PTHREAD_INTERNAL_CRASH(t, "thread didn't terminate");
+	 *
+	 * so this syscall must not return: the closed-source kext frees the
+	 * thread's user stack and ends the calling thread.  Workqueue threads
+	 * never get here (XNU calls workq_thread_terminate() first).
+	 */
+	if (stackaddr != 0 && size != 0) {
+		(void)vm_deallocate(map, stackaddr, size);
 	}
+
+	printf("crossxnu: bsdthread_terminate: pid=%d freeaddr=0x%llx size=0x%llx\n",
+	    proc_getpid(p), (unsigned long long)stackaddr, (unsigned long long)size);
+
+	thread_terminate_self();
+
+	/*
+	 * Not reached: thread_terminate_self() ends the thread (and runs the
+	 * process exit path when it was the last one).
+	 */
+	panic("thread_terminate_self returned (thread %p)", (void *)th);
+}
