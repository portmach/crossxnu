+	 *         rdi              rsi    rdx            rcx         r8d    r9d
+	 *
+	 * `self` is the pthread_t for the workqueue thread, and it is also the
+	 * top of the thread's stack and the base for %gs TSD accesses.
+	 */
+	crossxnu_wq_stack_geometry(p, &stack_size, &wq_total);
+	stacklowaddr = stackaddr - stack_size;
+	crossxnu_wq_scratch_layout(stackaddr, &sc);
+	stack_pointer = stackaddr;
+
+	if (setup_flags & CROSSXNU_WQ_SETUP_EXIT_THREAD) {
+		nkevents = CROSSXNU_WQ_EXIT_THREAD_NKEVENT;
+	} else {
+		/*
+		 * "Pulling in kevent structs onto the stack" (the comment above
+		 * workq_setup_and_run() in pthread_workqueue.c): ask the kevent
+		 * subsystem for whatever is pending on the kqueue/workloop this
+		 * thread is bound to and let it write the events into the scratch
+		 * area below the pthread struct.
+		 */
+		user_size_t data_available = CROSSXNU_WQ_KEVENT_DATA_SIZE;
+		int32_t     retval = 0;
+		int         error;
+
+		error = kevent_workq_internal(p, 0, 0, sc.eventlist,
+		    CROSSXNU_WQ_KEVENT_LIST_LEN, sc.data_out, &data_available,
+		    KEVENT_FLAG_STACK_DATA | KEVENT_FLAG_IMMEDIATE, &retval);
+		if (error == 0) {
+			keventlist = sc.eventlist;
+			nkevents = retval;
+			stack_pointer = sc.stack_pointer;
+		} else {
+			printf("crossxnu: workq_setup_thread: kevent_workq_internal "
+			    "failed pid=%d error=%d\n", proc_getpid(p), error);
+			nkevents = 0;
+			keventlist = sc.eventlist;
+		}
+	}
+
+	memset(&state, 0, sizeof(state));
+	state.rip = proc_get_wqthread(p);
+	state.rsp = stack_pointer;
+	state.rdi = stackaddr;          /* pthread_t self */
+	state.rsi = kport;              /* thread port name in the task */
+	state.rdx = stacklowaddr;       /* low end of the usable stack */
+	state.rcx = keventlist;         /* [kqid][kevent...] */
+	state.r8  = (uint64_t)(uint32_t)(upcall_flags | CROSSXNU_WQ_FLAG_THREAD_TSD_BASE_SET);
+	state.r9  = (uint64_t)(uint32_t)nkevents;
+
+	if ((setup_flags & CROSSXNU_WQ_SETUP_EXIT_THREAD) == 0 && nkevents > 0) {
+		printf("crossxnu: workq_setup_thread: pid=%d events=%d flags=0x%x\n",
+		    proc_getpid(p), nkevents, upcall_flags);
+	}
+
+	(void)thread_set_wq_state64(th, (thread_state_t)&state);
+	(void)thread_set_tsd_base(th,
+	    (mach_vm_offset_t)(stackaddr + CROSSXNU_PTHREAD_TSD_OFFSET));
+
+	thread_exception_return();
+}
