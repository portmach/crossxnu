+/*
+ * bsdthread_register() is what libpthread's initialiser calls; the state it
+ * stores in the proc is read back by the userland side.
+ */
+static int
+crossxnu_bsdthread_register(struct proc *p, user_addr_t threadstart,
+    user_addr_t wqthread, int pthsize, __unused user_addr_t dummy_value,
+    __unused user_addr_t targetconc_ptr, uint64_t dispatchqueue_offset,
+    int32_t *retval)
+{
+	proc_set_threadstart(p, threadstart);
+	proc_set_wqthread(p, wqthread);
+	proc_set_pthsize(p, pthsize);
+	proc_set_dispatchqueue_offset(p, dispatchqueue_offset);
+	p->p_lflag |= P_LREGISTER;
+	printf("crossxnu: bsdthread_register pid %d threadstart 0x%llx wqthread 0x%llx pthsize %d\n",
+	    proc_getpid(p), (unsigned long long)threadstart,
+	    (unsigned long long)wqthread, pthsize);
+	/*
+	 * The return value is not an error code: libpthread treats it as a
+	 * bitmask of supported features and traps with "libpthread has not been
+	 * initialized" when it is zero.  It requires at least 0x4000001e.
+	 */
+	*retval = CROSSXNU_PTHREAD_FEATURES;
+	return 0;
+}
+
+static int
+crossxnu_bsdthread_register2(struct proc *p, user_addr_t threadstart,
+    user_addr_t wqthread, uint32_t flags, user_addr_t stack_addr_hint,
+    user_addr_t targetconc_ptr, uint32_t dispatchqueue_offset,
+    uint32_t tsd_offset, int32_t *retval)
+{
+	proc_set_threadstart(p, threadstart);
+	proc_set_wqthread(p, wqthread);
+	proc_set_stack_addr_hint(p, stack_addr_hint);
+	proc_set_dispatchqueue_offset(p, dispatchqueue_offset);
+	p->p_lflag |= P_LREGISTER;
+	/*
+	 * crossxnu: libpthread passes PTHREAD_SIZE (the size of struct pthread_s)
+	 * in the `flags` slot of bsdthread_register, and does *not* pass a
+	 * tsd_offset argument at all: the 7th syscall argument is left unset, so
+	 * whatever arrives there is garbage from the previous register.  The TSD
+	 * offset is a fixed property of the ABI.
+	 */
+	proc_set_pthsize(p, (int)flags);
+	proc_set_pthread_tsd_offset(p, CROSSXNU_PTHREAD_TSD_OFFSET);
+	(void)tsd_offset;
+	printf("crossxnu: bsdthread_register2 pid %d threadstart 0x%llx wqthread 0x%llx "
+	    "flags=0x%x hint=0x%llx tc=0x%llx dqo=0x%x tsd=0x%x\n",
+	    proc_getpid(p), (unsigned long long)threadstart,
+	    (unsigned long long)wqthread, flags,
+	    (unsigned long long)stack_addr_hint, (unsigned long long)targetconc_ptr,
+	    dispatchqueue_offset, tsd_offset);
+	*retval = CROSSXNU_PTHREAD_FEATURES;
+	return 0;
+}
