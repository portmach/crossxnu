+/*
+ * crossxnu: the x86 console path is the km driver (km_tty[0]), which the
+ * synthetic platform expert never registers because there is no PS/2/VGA
+ * platform behind it.  Back /dev/console directly with the serial UART so
+ * userland can read and write its console.
+ */
+static boolean_t
+crossxnu_serial_console(void)
+{
+	/*
+	 * kminit() always runs, so a km tty exists, but it is backed by the VGA
+	 * framebuffer and PS/2 keyboard.  With no display attached the serial
+	 * UART is the only console that goes anywhere, so always prefer it.
+	 */
+	return TRUE;
+}
+
+static int
+crossxnu_serial_read(struct uio *uio)
+{
+	int error = 0;
+	while (uio_resid(uio) != 0) {
+		int c = serial_getc();
+		if (c < 0) {
+			continue;
+		}
+		if (c == '\r') {
+			c = '\n';
+		}
+		if ((error = uiomove(&c, 1, uio)) != 0) {
+			break;
+		}
+		if (c == '\n') {
+			break;
+		}
+	}
+	return error;
+}
+
+static int
+crossxnu_serial_write(struct uio *uio)
+{
+	int error = 0;
+	char c = 0;
+	while (uio_resid(uio) != 0) {
+		if ((error = uiomove(&c, 1, uio)) != 0) {
+			break;
+		}
+		if (c == '\n') {
+			serial_putc('\r');
+		}
+		serial_putc(c);
+	}
+	return error;
+}
+#endif /* CROSSXNU_SECURITY_PERMISSIVE */
