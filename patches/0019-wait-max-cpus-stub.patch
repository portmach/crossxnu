 {
+#ifdef CROSSXNU_SECURITY_PERMISSIVE
+	/*
+	 * crossxnu: the built-in platform expert stub does not enumerate CPUs,
+	 * so ml_set_max_cpus() is never called and this would sleep forever.
+	 * Declare the boot CPU instead of waiting.  A real ACPI platform
+	 * expert will call ml_set_max_cpus() with the real count.
+	 */
+	if (max_cpus_initialized != MAX_CPUS_SET) {
+		machine_info.max_cpus = 1;
+		max_cpus_initialized = MAX_CPUS_SET;
+		return 1;
+	}
+#endif
 	lck_mtx_lock(&max_cpus_lock);
 	while (max_cpus_initialized != MAX_CPUS_SET) {
 		max_cpus_initialized = MAX_CPUS_WAIT;
