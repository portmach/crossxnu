+/*
+ * crossxnu: user-mode #UD diagnostics.
+ *
+ * Finding the failing instruction in a dylib is otherwise guesswork: images are
+ * slid by dyld, so a raw RIP says nothing.  Dumping the instruction bytes (and
+ * the offset inside the page) is enough to locate them in the image on the
+ * host, and it also shows when the bytes are not the ones in the file at all.
+ */
+static void
+crossxnu_report_user_ud(uintptr_t rip)
+{
+	uint8_t  insn[16];
+	char     hex[3 * 16 + 1];
+	int      i;
+	int      got;
+
+	got = (copyin((user_addr_t)rip, insn, sizeof(insn)) == 0) ? (int)sizeof(insn) : 0;
+
+	for (i = 0; i < got; i++) {
+		static const char digits[] = "0123456789abcdef";
+
+		hex[i * 3 + 0] = digits[(insn[i] >> 4) & 0xf];
+		hex[i * 3 + 1] = digits[insn[i] & 0xf];
+		hex[i * 3 + 2] = (i + 1 == got) ? '\0' : ' ';
+	}
+	if (got == 0) {
+		hex[0] = '\0';
+	}
+
+	printf("crossxnu: user #UD rip=0x%llx page_off=0x%llx insn=%s%s\n",
+	    (unsigned long long)rip,
+	    (unsigned long long)(rip & 0xfff),
+	    hex,
+	    got ? "" : "<copyin failed>");
+}
+#endif /* CROSSXNU_SECURITY_PERMISSIVE */
