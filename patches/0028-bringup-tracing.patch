+/*
+ * crossxnu: temporary bring-up diagnostic (see pthread_workqueue.c).
+ *
+ * Dumps the scheduler state of every thread of a process.  Called from a
+ * delayed thread call when pid 1 stops making progress, to name the blocking
+ * primitive through the kernel continuation each thread is parked in.
+ */
+void crossxnu_threads_dump(struct proc *p, const char *where);
+
+void
+crossxnu_threads_dump(struct proc *p, const char *where)
+{
+	task_t task = proc_task(p);
+	thread_t th;
+	uint64_t tids[24];
+	uint16_t tags[24];
+	int states[24];
+	uint32_t opts[24];
+	uintptr_t conts[24];
+	uint64_t evs[24];
+	uint64_t sysu[24], sysm[24], csw[24];
+	uint64_t urips[24];
+	int runqs[24];
+	int n = 0, i;
+
+	if (task == NULL) {
+		return;
+	}
+
+	task_lock(task);
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (n >= 24) {
+			break;
+		}
+		tids[n] = thread_tid(th);
+		tags[n] = thread_get_tag(th);
+		states[n] = th->state;
+		opts[n] = th->options;
+		conts[n] = (uintptr_t)th->continuation;
+		evs[n] = (uint64_t)th->wait_event;
+		sysu[n] = th->syscalls_unix;
+		sysm[n] = th->syscalls_mach;
+		csw[n] = th->c_switch;
+		/*
+		 * crossxnu: where the thread entered the kernel from.  For a
+		 * blocked thread this names the userspace caller that is stuck,
+		 * which the kernel continuation alone cannot tell.
+		 */
+		urips[n] = 0;
+		{
+			x86_saved_state_t *iss = USER_STATE(th);
+
+			if (iss != NULL && is_saved_state64(iss)) {
+				urips[n] = saved_state64(iss)->isf.rip;
+			}
+		}
+		{
+			int k;
+
+			runqs[n] = -2;
+			for (k = 0; k < MAX_CPUS; k++) {
+				if (processor_array[k] != (processor_t)0 &&
+				    processor_array[k] == th->__runq.runq) {
+					runqs[n] = k;
+					break;
+				}
+			}
+			if (runqs[n] == -2 && th->__runq.runq != (processor_t)0) {
+				runqs[n] = -1;   /* queued on some processor we cannot find */
+			}
+		}
+		n++;
+	}
+	task_unlock(task);
+
+	printf("crossxnu: threads(%s): pid=%d n=%d\n", where, proc_getpid(p), n);
+	for (i = 0; i < n; i++) {
+		/*
+		 * Kernel addresses are printed as two 32-bit halves: printf()
+		 * replaces any value that looks like a kernel pointer with
+		 * "<ptr>" when the output goes to a log.
+		 */
+		printf("crossxnu: threads(%s):  tid=%llu tag=0x%x state=0x%x opt=0x%x "
+		    "cont=%08x%08x ev=%08x%08x sys=%llu/%llu cs=%llu runq=%d "
+		    "urip=%08x%08x\n",
+		    where, (unsigned long long)tids[i], tags[i], states[i], opts[i],
+		    (unsigned)(conts[i] >> 32), (unsigned)conts[i],
+		    (unsigned)(evs[i] >> 32), (unsigned)evs[i],
+		    (unsigned long long)sysu[i], (unsigned long long)sysm[i],
+		    (unsigned long long)csw[i], runqs[i],
+		    (unsigned)(urips[i] >> 32), (unsigned)urips[i]);
+	}
+}
+
+/*
+ * crossxnu: temporary bring-up diagnostic.
+ *
+ * Locates libdispatch in a process by scanning its executable mappings for a
+ * known string, then dumps the main queue object (__dispatch_main_q) so we can
+ * tell whether the queue has pending items (a non-null tail) and in which
+ * state it is, i.e. whether launchd really has nothing to do or whether a
+ * queued item is stuck.
+ */
+extern kern_return_t copyinmap(vm_map_t map, vm_map_offset_t fromaddr,
+    void *todata, vm_size_t length);
+
+void crossxnu_dispatch_dump(struct proc *p, const char *where);
+
+void
+crossxnu_dispatch_dump(struct proc *p, const char *where)
+{
+	static const char needle[] =
+	    "BUG IN CLIENT OF LIBDISPATCH: dispatch_main() must be called on the main thread";
+	/* file/vm offsets in the libdispatch.dylib of this build */
+	const uint64_t needle_off = 0x3abaa;
+	const uint64_t mainq_off = 0x5fe40;
+	task_t task = proc_task(p);
+	vm_map_t map;
+	vm_map_entry_t entry;
+	uint64_t found = 0, base, scanned = 0;
+	char page[4096];
+	uint64_t q[32];
+	size_t i;
+
+	if (task == NULL) {
+		return;
+	}
+	map = get_task_map(task);
+	if (map == NULL) {
+		return;
+	}
+
+	/* no map lock: dump-only, the process is idle */
+	entry = vm_map_first_entry(map);
+	while (entry != vm_map_to_entry(map)) {
+		vm_map_offset_t start, end;
+
+		if (entry->is_sub_map || !(entry->protection & VM_PROT_EXECUTE)) {
+			entry = entry->vme_next;
+			continue;
+		}
+		start = entry->vme_start;
+		end = entry->vme_end;
+		if (end - start > 512ULL * 1024 * 1024) {
+			end = start + 512ULL * 1024 * 1024;
+		}
+		for (; start < end; start += sizeof(page)) {
+			if (scanned > 1024ULL * 1024 * 1024) {
+				break;
+			}
+			scanned += sizeof(page);
+			if (copyinmap(map, start, page, sizeof(page)) != KERN_SUCCESS) {
+				continue;
+			}
+			for (i = 0; i + sizeof(needle) <= sizeof(page); i++) {
+				if (page[i] == 'B' &&
+				    memcmp(page + i, needle, sizeof(needle)) == 0) {
+					found = start + i;
+					break;
+				}
+			}
+			if (found != 0) {
+				break;
+			}
+		}
+		if (found != 0) {
+			break;
+		}
+		entry = entry->vme_next;
+	}
+
+	if (found == 0) {
+		printf("crossxnu: dispatch(%s): libdispatch not found (scanned %llu MB)\n",
+		    where, (unsigned long long)(scanned >> 20));
+		return;
+	}
+	base = found - needle_off;
+	printf("crossxnu: dispatch(%s): libdispatch base=0x%08x%08x\n", where,
+	    (unsigned)(base >> 32), (unsigned)base);
+
+	if (copyinmap(map, base + mainq_off, q, sizeof(q)) != KERN_SUCCESS) {
+		printf("crossxnu: dispatch(%s): cannot read __dispatch_main_q\n", where);
+		return;
+	}
+	for (i = 0; i < sizeof(q) / sizeof(q[0]); i += 4) {
+		printf("crossxnu: dispatch(%s): q+0x%03llx = %08x%08x %08x%08x "
+		    "%08x%08x %08x%08x\n", where, (unsigned long long)(i * 8),
+		    (unsigned)(q[i] >> 32), (unsigned)q[i],
+		    (unsigned)(q[i + 1] >> 32), (unsigned)q[i + 1],
+		    (unsigned)(q[i + 2] >> 32), (unsigned)q[i + 2],
+		    (unsigned)(q[i + 3] >> 32), (unsigned)q[i + 3]);
+	}
+}
+
+/* crossxnu: temporary diagnostic helper (see pthread_workqueue.c) */
+int crossxnu_thread_runnable(thread_t th);
+
+int
+crossxnu_thread_runnable(thread_t th)
+{
+	return (th->state & TH_RUN) != 0;
+}
+
+/*
+ * crossxnu: temporary bring-up diagnostic.
+ *
+ * Prints the state of every processor: its active thread, its idle thread and
+ * how many threads sit on its run queue.  Used to tell "a thread is blocked"
+ * apart from "a thread is runnable but the CPU never picks it up".
+ */
+void crossxnu_cpus_dump(const char *where);
+
+void
+crossxnu_cpus_dump(const char *where)
+{
+	processor_t cpu;
+	int i;
+
+	printf("crossxnu: cpu(%s): machine logical=%d physical=%d max=%d "
+	    "extra=%d\n", where, machine_info.logical_cpu,
+	    machine_info.physical_cpu, machine_info.logical_cpu_max, 0);
+
+	for (i = 0; i < MAX_CPUS; i++) {
+		thread_t act, idl;
+		int count = 0;
+
+		cpu = processor_array[i];
+		if (cpu == (processor_t)0) {
+			continue;
+		}
+		act = cpu->active_thread;
+		idl = cpu->idle_thread;
+		if (cpu->runq.count > 0) {
+			count = cpu->runq.count;
+		}
+		printf("crossxnu: cpu(%s): id=%d state=0x%x active=%d(st=0x%x)"
+		    ".idle=%d(st=0x%x) runq=%d urgency=%d\n", where,
+		    cpu->cpu_id, cpu->state,
+		    act != (thread_t)0 ? (int)thread_tid(act) : -1,
+		    act != (thread_t)0 ? act->state : 0,
+		    idl != (thread_t)0 ? (int)thread_tid(idl) : -1,
+		    idl != (thread_t)0 ? idl->state : 0,
+		    count, (int)cpu->runq.urgency);
+	}
+}
diff --git a/osfmk/kern/sched_prim.c b/osfmk/kern/sched_prim.c
index b2aae03..966c7b9 100644
--- a/osfmk/kern/sched_prim.c
+++ b/osfmk/kern/sched_prim.c
@@ -136,6 +136,89 @@
 struct sched_statistics PERCPU_DATA(sched_stats);
 bool sched_stats_active;
 
+/*
+ * crossxnu bring-up diagnostics: a lockless ring of the most recent scheduler
+ * decisions.  The hot paths only store words here; the watchdog (BSD side)
+ * drains the ring later, once the machine is wedged and printf is safe.
+ */
+struct crossxnu_sched_entry {
+	uint64_t        cs_time;
+	uint32_t        cs_ev;
+	uint32_t        cs_tid;
+	uint32_t        cs_a;
+	uint32_t        cs_b;
+	uint32_t        cs_c;
+	uint32_t        cs_d;
+};
+
+#define CROSSXNU_SCHED_RING_SIZE        512
+#define CROSSXNU_SCHED_RING_MASK        (CROSSXNU_SCHED_RING_SIZE - 1)
+
+static struct crossxnu_sched_entry crossxnu_sched_ring[CROSSXNU_SCHED_RING_SIZE];
+static unsigned int crossxnu_sched_ring_next;
+static unsigned int crossxnu_sched_dump_next;
+
+void crossxnu_sched_dump(const char *where);
+
+/* event codes, kept in sync with the dump formatting below */
+#define CXSE_SETRUN     1       /* thread_setrun: tid, pri, options, runq, state */
+#define CXSE_PSETRUN    2       /* processor_setrun: tid, pri, cur_pri, preempt, action, pstate */
+#define CXSE_SELECT     3       /* thread_select entry: tid, reason, cur_pri, state */
+#define CXSE_SELOUT     4       /* thread_select outcome: tid, outcome, main, bound, highq */
+#define CXSE_INVOKE     5       /* thread_invoke: self, new, reason, self state */
+#define CXSE_IDLE       6       /* processor_idle entry: tid, state, main, bound */
+#define CXSE_IDLEBRK    7       /* processor_idle break: reason, main, bound, state */
+#define CXSE_DISPATCH   8       /* thread_dispatch: old, new, still_runnable, options */
+#define CXSE_IPI        9       /* sched_ipi_perform: cpu, type */
+#define CXSE_STEAL      10      /* steal attempt: found tid, main, bound */
+
+static inline void
+crossxnu_sched_log(uint32_t ev, uint32_t tid, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{
+	unsigned int i = crossxnu_sched_ring_next & CROSSXNU_SCHED_RING_MASK;
+	struct crossxnu_sched_entry *e = &crossxnu_sched_ring[i];
+
+	e->cs_time = mach_absolute_time();
+	e->cs_ev   = ev;
+	e->cs_tid  = tid;
+	e->cs_a    = a;
+	e->cs_b    = b;
+	e->cs_c    = c;
+	e->cs_d    = d;
+	crossxnu_sched_ring_next = i + 1;
+}
+
+void
+crossxnu_sched_dump(const char *where)
+{
+	static const char *const ev_names[] = {
+		"?", "setrun", "psetrun", "select", "selout",
+		"invoke", "idle", "idlebrk", "dispatch", "ipi", "steal"
+	};
+	unsigned int next = crossxnu_sched_ring_next;
+	unsigned int start;
+	unsigned int n;
+
+	if (next - crossxnu_sched_dump_next > CROSSXNU_SCHED_RING_SIZE) {
+		crossxnu_sched_dump_next = next - CROSSXNU_SCHED_RING_SIZE;
+	}
+	start = crossxnu_sched_dump_next;
+	n = next - start;
+
+	printf("crossxnu: sched ring (%s): %u new events, %u total\n",
+	    where, n, next);
+	for (unsigned int k = 0; k < n; k++) {
+		unsigned int idx = (start + k) & CROSSXNU_SCHED_RING_MASK;
+		struct crossxnu_sched_entry *e = &crossxnu_sched_ring[idx];
+		const char *name = (e->cs_ev < sizeof(ev_names) / sizeof(ev_names[0])) ?
+		    ev_names[e->cs_ev] : "?";
+
+		printf("crossxnu: sched %05u t=%llu %-8s tid=%u a=%u b=%u c=%u d=%u\n",
+		    idx, e->cs_time, name, e->cs_tid, e->cs_a, e->cs_b, e->cs_c, e->cs_d);
+	}
+	crossxnu_sched_dump_next = next;
+}
+
