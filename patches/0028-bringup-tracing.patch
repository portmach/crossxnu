diff --git a/bsd/dev/i386/systemcalls.c b/bsd/dev/i386/systemcalls.c
index a352414..01b0da3 100644
--- a/bsd/dev/i386/systemcalls.c
+++ b/bsd/dev/i386/systemcalls.c
@@ -59,6 +59,281 @@
 
 #if CONFIG_MACF
 #include <security/mac_framework.h>
+
+/*
+ * crossxnu: bring-up tracing for pid 1.
+ *
+ * Prints every syscall and mach trap of pid 1 with the calling thread id and
+ * its user-space return address, plus the paths it opens, so that the tail of
+ * the log identifies what launchd was doing when it stopped making progress.
+ */
+extern void crossxnu_trace_pid1(const char *what, uint64_t a, uint64_t b);
+extern void crossxnu_trace_path(struct proc *p, int code, uint64_t *arg);
+extern void crossxnu_trace_ret(struct proc *p, int code, int error,
+    uint64_t rval);
+
+void
+crossxnu_trace_pid1(const char *what, uint64_t a, uint64_t b)
+{
+	static int nsys, nmach, nfork, nline;
+	struct proc *cp = current_proc();
+	uint64_t tid;
+
+	if (cp == NULL) {
+		return;
+	}
+	/*
+	 * crossxnu: trace pid 1 and its direct children.  The boot hangs we
+	 * chase also happen inside helpers launchd spawns (mount_hfs,
+	 * cc_fips_test, dirs_cleaner, ...), which a pid-1-only filter hides.
+	 */
+	if (cp->p_pid != 1 && cp->p_ppid != 1) {
+		return;
+	}
+	tid = thread_tid(current_thread());
+	if (what[0] == 's') {
+		nline++;
+		if (cp->p_pid == 1 && ++nsys <= 1200) {
+			printf("crossxnu: p1 sys %llu tid=%llu rip=0x%llx\n",
+			    a, tid, b);
+		} else {
+			printf("S%llu.%d.%llu ", a, cp->p_pid, tid);
+			if (nline % 8 == 0) {
+				printf("\n");
+			}
+		}
+	} else if (what[0] == 'm') {
+		nline++;
+		if (cp->p_pid == 1 && ++nmach <= 800) {
+			printf("crossxnu: p1 mach %llu tid=%llu rip=0x%llx\n",
+			    a, tid, b);
+		} else {
+			printf("M%llu.%d.%llu ", a, cp->p_pid, tid);
+			if (nline % 8 == 0) {
+				printf("\n");
+			}
+		}
+	} else {
+		nfork++;
+		if (nfork <= 200) {
+			printf("crossxnu: fork %llu -> %llu\n", a, b);
+		}
+	}
+}
+
+/*
+ * crossxnu: bring-up tracing of the paths pid 1 asks the kernel for.  Shows
+ * whether launchd reaches the point of scanning its job database
+ * (/Library/LaunchDaemons/...) or stops before it.
+ */
+extern int copyinstr(const user_addr_t uaddr, void *kaddr, size_t len,
+    size_t *done);
+extern const char *syscallnames[];
+
+/*
+ * crossxnu: dump the payload of pid 1's write() calls, escaped to printable
+ * ASCII, so launchd's own log text survives the (in-memory) ramdisk.
+ */
+static void
+crossxnu_trace_write(struct proc *p, int code, uint64_t *arg)
+{
+	static int nwrite;
+	static char buf[2048];
+	uint64_t fd = arg[0];
+	uint64_t len = arg[2];
+	size_t n, i;
+
+	if (p->p_pid != 1 || nwrite >= 400) {
+		return;
+	}
+	if (arg[1] == 0 || len == 0) {
+		return;
+	}
+	n = (size_t)(len > sizeof(buf) - 1 ? sizeof(buf) - 1 : len);
+	if (copyin((user_addr_t)arg[1], buf, n) != 0) {
+		return;
+	}
+	nwrite++;
+	for (i = 0; i < n; i++) {
+		unsigned char c = (unsigned char)buf[i];
+
+		if (c == '\n' || c == '\t') {
+			continue;
+		}
+		if (c < 0x20 || c >= 0x7f) {
+			buf[i] = '.';
+		}
+	}
+	buf[n] = '\0';
+	printf("crossxnu: p1 write fd=%llu n=%llu <%s>\n",
+	    (unsigned long long)fd, (unsigned long long)len, buf);
+}
+
+static int
+crossxnu_path_has_launch(const char *s)
+{
+	for (; *s != '\0'; s++) {
+		if (s[0] == 'L' && s[1] == 'a' && s[2] == 'u' &&
+		    s[3] == 'n' && s[4] == 'c' && s[5] == 'h') {
+			return 1;
+		}
+	}
+	return 0;
+}
+
+/*
+ * crossxnu: record the result of every pid-1 syscall so a later abort can be
+ * explained by the calls that failed just before it.  The ring keeps the last
+ * 24 calls (number, errno, return value) and is dumped when pid 1 exits or
+ * calls abort_with_payload().
+ */
+struct crossxnu_ret_entry {
+	int      re_code;
+	int      re_error;
+	uint64_t re_rval;
+};
+
+static struct crossxnu_ret_entry crossxnu_ret_ring[24];
+static unsigned int crossxnu_ret_next;
+static unsigned int crossxnu_ret_dumped;
+
+static const char *
+crossxnu_syscall_name(int code)
+{
+	return (code >= 0 && code < 600 && syscallnames[code] != NULL) ?
+	       syscallnames[code] : "?";
+}
+
+void
+crossxnu_trace_ret(struct proc *p, int code, int error, uint64_t rval)
+{
+	unsigned int i;
+
+	if (p == NULL || p->p_pid != 1) {
+		return;
+	}
+	i = crossxnu_ret_next & 23;
+	crossxnu_ret_ring[i].re_code = code;
+	crossxnu_ret_ring[i].re_error = error;
+	crossxnu_ret_ring[i].re_rval = rval;
+	crossxnu_ret_next++;
+
+	if (error != 0) {
+		printf("crossxnu: p1 errno %s(%d) = %d\n",
+		    crossxnu_syscall_name(code), code, error);
+	}
+	if (code == 1 || code == 521) {         /* exit, abort_with_payload */
+		unsigned int n = crossxnu_ret_next - crossxnu_ret_dumped;
+		unsigned int start = crossxnu_ret_dumped;
+
+		if (n > 24) {
+			start = crossxnu_ret_next - 24;
+			n = 24;
+		}
+		printf("crossxnu: p1 last %u calls before %s:\n", n,
+		    crossxnu_syscall_name(code));
+		for (unsigned int k = 0; k < n; k++) {
+			unsigned int idx = (start + k) & 23;
+			struct crossxnu_ret_entry *e = &crossxnu_ret_ring[idx];
+
+			printf("crossxnu: p1 ret %-22s code=%-4d err=%-3d rv=%lld\n",
+			    crossxnu_syscall_name(e->re_code), e->re_code,
+			    e->re_error, (long long)e->re_rval);
+		}
+		crossxnu_ret_dumped = crossxnu_ret_next;
+	}
+}
+
+void
+crossxnu_trace_path(struct proc *p, int code, uint64_t *arg)
+{
+	static int npath;
+	char buf[160];
+	user_addr_t upath;
+	size_t done = 0;
+	int idx;
+
+	if (p == NULL) {
+		return;
+	}
+	/*
+	 * crossxnu: trace pid 1 and its direct children.  The boot hangs we
+	 * chase also happen inside helpers launchd spawns (mount_hfs,
+	 * cc_fips_test, dirs_cleaner, ...), which a pid-1-only filter hides.
+	 */
+	if (p->p_pid != 1 && p->p_ppid != 1) {
+		return;
+	}
+	/*
+	 * crossxnu: dump what launchd writes.  Its own log file
+	 * (/private/var/log/com.apple.xpc.launchd/launchd.log) lives in the
+	 * ramdisk and is lost after the boot, so the text has to be captured on
+	 * the way into the kernel.
+	 */
+	switch (code) {
+	case 4:         /* write */
+	case 397:       /* write_nocancel */
+		crossxnu_trace_write(p, code, arg);
+		return;
+	default:
+		break;
+	}
+	switch (code) {
+	case 12:        /* chdir */
+	case 58:        /* readlink */
+	case 188:       /* stat */
+	case 5:         /* open */
+	case 59:        /* execve */
+	case 10:        /* unlink */
+	case 15:        /* chmod */
+	case 33:        /* access */
+	case 136:       /* mkdir */
+	case 220:       /* getattrlist */
+	case 338:       /* stat64 */
+	case 340:       /* lstat64 */
+	case 398:       /* open_nocancel */
+		idx = 0;
+		break;
+	case 244:       /* posix_spawn */
+	case 463:       /* openat */
+	case 464:       /* openat_nocancel */
+	case 469:       /* fstatat */
+	case 470:       /* fstatat64 */
+	case 472:       /* unlinkat */
+	case 473:       /* readlinkat */
+	case 475:       /* mkdirat */
+		idx = 1;
+		break;
+	default:
+		return;
+	}
+	upath = (user_addr_t)arg[idx];
+	if (upath == 0) {
+		return;
+	}
+	/*
+	 * copyinstr() unconditionally stores the transferred size through the
+	 * `done` pointer, so it must not be NULL.
+	 */
+	if (copyinstr(upath, buf, sizeof(buf), &done) != 0) {
+		return;
+	}
+	npath++;
+	/*
+	 * crossxnu: pid 1 gets a complete path trace - the point of this
+	 * diagnostic is to see which configuration paths launchd opens at all,
+	 * so nothing may be dropped by a cap.  Children stay filtered.
+	 */
+	if (p->p_pid == 1) {
+		printf("crossxnu: p1 path %s <%s>\n",
+		    (code >= 0 && code < 600 && syscallnames[code] != NULL) ?
+		    syscallnames[code] : "?", buf);
+	} else if (crossxnu_path_has_launch(buf)) {
+		printf("crossxnu: path %s pid=%d <%s>\n",
+		    (code >= 0 && code < 600 && syscallnames[code] != NULL) ?
+		    syscallnames[code] : "?", p->p_pid, buf);
+	}
+}
 #endif
 
 #if CONFIG_DTRACE
@@ -308,6 +583,7 @@ unix_syscall64(x86_saved_state_t *state)
 
 	code    = regs->rax & SYSCALL_NUMBER_MASK;
 	syscode = (code < nsysent) ? code : SYS_invalid;
+	crossxnu_trace_pid1("sys", code, regs->isf.rip);
 	DEBUG_KPRINT_SYSCALL_UNIX(
 		"unix_syscall64: code=%d(%s) rip=%llx\n",
 		code, syscallnames[syscode], regs->isf.rip);
@@ -360,6 +636,9 @@ unix_syscall64(x86_saved_state_t *state)
 		KDBG_RELEASE(BSDDBG_CODE(DBG_BSD_EXCP_SC, code) | DBG_FUNC_START);
 	}
 
+	/* crossxnu: bring-up tracing of file paths for pid 1 */
+	crossxnu_trace_path(p, code, (uint64_t *)vt);
+
 	current_cached_proc_cred_update();
 
 	uthread->uu_rval[0] = 0;
@@ -386,6 +665,9 @@ unix_syscall64(x86_saved_state_t *state)
 	error = (*(callp->sy_call))((void *) p, vt, &(uthread->uu_rval[0]));
 	AUDIT_SYSCALL_EXIT(code, p, uthread, error);
 
+	/* crossxnu: record pid 1's syscall results for post-mortem analysis */
+	crossxnu_trace_ret(p, code, error, uthread->uu_rval[0]);
+
 #if CONFIG_MACF
 skip_syscall:
 #endif /* CONFIG_MACF */
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 949728f..74a44e9 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -481,6 +481,117 @@ bsd_rooted_ramdisk(void)
  * of the tro_ucred field so that the uthread structure can be
  * used like any other.
  */
+#ifdef CROSSXNU_SECURITY_PERMISSIVE
+/* bsd_init.c is C, so no IOKit class headers here: the rammedia kext dumps the
+ * I/O Registry (it is C++ and loads before this point). */
+
+/*
+ * Report which /dev nodes exist: when the APFS volume never gets one, the
+ * question is which of the container media, its BSD client and the volume are
+ * actually present.
+ */
+static void
+crossxnu_probe_devfs(void)
+{
+	static const char *const paths[] = {
+		"/dev/console", "/dev/null", "/dev/md0", "/dev/md1",
+		"/dev/disk0", "/dev/disk0s1", NULL
+	};
+
+	for (int i = 0; paths[i] != NULL; i++) {
+		vnode_t vp = NULLVP;
+		int err = vnode_lookup(paths[i], 0, &vp, vfs_context_kernel());
+
+		printf("crossxnu: probe %s -> %d\n", paths[i], err);
+		if (err == 0) {
+			vnode_put(vp);
+		}
+	}
+}
+
+/*
+ * crossxnu: mount the APFS volume that the rammedia kext publishes.
+ *
+ * Non-static on purpose: this keeps it in the kernel symbol table so the
+ * kext can call it again once the media BSD client has created the /dev node.
+ *
+ * APFS mounts only the *container* (nx_mount) when its container scheme
+ * starts; a volume is a separate VFS mount, which on macOS is launchd's job -
+ * and launchd skips apfs_boot_util entirely unless the root is already APFS.
+ * On this HFS+ root its fsctl(APFSIOC_GET_DEV_BY_ROLE) therefore answers
+ * ENOENT forever, so the mount is done from the kernel instead.
+ *
+ * The /dev node comes from an IOMedia BSD client, which only matches once
+ * IOKitBSDInit() has published the IOBSD resource and the matching cascade has
+ * run, so poll for a while rather than assuming it is already there.
+ *
+ * kernel_mount() takes mount(2)'s extra indirection (a user_addr_t pointing at
+ * the device path), hence the address of the stack pointer, as imageboot.c
+ * does for the base-system mount.
+ */
+void crossxnu_mount_apfs_volume(void);
+
+void
+crossxnu_mount_apfs_volume(void)
+{
+	static const char *const candidates[] = {
+		"/dev/disk0s1", "/dev/disk0s2", "/dev/disk0s3",
+		"/dev/disk0", NULL
+	};
+	static const char *const mountpoints[] = { "/mnt1", "/Volumes", NULL };
+
+	for (int attempt = 0; attempt < 60; attempt++) {
+		for (int c = 0; candidates[c] != NULL; c++) {
+			vnode_t devvp = NULLVP;
+			char devpath[64];
+			char *devpathp;
+			char **devpathpp;
+
+			if (vnode_lookup(candidates[c], 0, &devvp,
+			    vfs_context_kernel()) != 0) {
+				continue;
+			}
+			vnode_put(devvp);
+
+			/* Mount(2)'s data argument points at the device path. */
+			strlcpy(devpath, candidates[c], sizeof(devpath));
+			devpathp = &devpath[0];
+			devpathpp = &devpathp;
+
+			for (int m = 0; mountpoints[m] != NULL; m++) {
+				vnode_t mntvp = NULLVP;
+				int merr;
+
+				if (vnode_lookup(mountpoints[m], 0, &mntvp,
+				    vfs_context_kernel()) != 0) {
+					continue;
+				}
+				vnode_put(mntvp);
+
+				merr = kernel_mount("apfs", NULLVP, NULLVP,
+				    mountpoints[m], devpathpp, 0,
+				    (MNT_RDONLY | MNT_DONTBROWSE),
+				    KERNEL_MOUNT_NOAUTH, vfs_context_kernel());
+
+				printf("crossxnu: mount -t apfs %s %s -> %d\n",
+				    candidates[c], mountpoints[m], merr);
+				if (merr == 0) {
+					return;
+				}
+			}
+		}
+
+		if (attempt == 0) {
+			printf("crossxnu: no APFS volume node yet, polling\n");
+		}
+		IOSleep(250);
+	}
+
+	printf("crossxnu: gave up waiting for an APFS volume node\n");
+	crossxnu_probe_devfs();
+}
+#endif /* CROSSXNU_SECURITY_PERMISSIVE */
+
 void
 bsd_init(void)
 {
@@ -1065,6 +1176,54 @@ bsd_init(void)
 	}
 #endif
 
+	/*
+	 * crossxnu: load our validation kext out of the primary kernel
+	 * collection.
+	 *
+	 * Kexts that come from a prelinked collection are only *registered* at
+	 * boot ("registered and available for loading"); something has to ask
+	 * for them.  On real macOS that is the IOCatalogue matching a
+	 * personality, or kextd pushing a load request.  Our synthetic
+	 * collection has no personalities at all, so ask for the kext by
+	 * identifier explicitly.
+	 */
+	{
+		extern kern_return_t OSKextLoadKextWithIdentifier(const char *bundle_id);
+		kern_return_t crossxnu_kr;
+
+		/*
+		 * Our RAM-backed block device comes first: it publishes an
+		 * IOBlockStorageDevice, IOStorageFamily's generic driver turns
+		 * that into an IOMedia, and only then has APFS something to
+		 * mount.  Its kmod start() builds the device and registers it, so
+		 * no personality has to match for this to happen.
+		 */
+		crossxnu_kr = OSKextLoadKextWithIdentifier(
+		    "com.crossxnu.driver.CrossXnuRAMStorage");
+		bsd_init_kprintf("crossxnu: OSKextLoadKextWithIdentifier("
+		    "com.crossxnu.driver.CrossXnuRAMStorage) -> %d\n", crossxnu_kr);
+
+		/*
+		 * The target: Apple's APFS, taken from the KDK (a normal
+		 * unprelinked kext) and prelinked into our collection together
+		 * with the small set of kexts it imports from
+		 * (IOStorageFamily, CoreAnalyticsFamily, AppleEffaceableStorage,
+		 * AppleImage4, corecrypto).  OSKext resolves and starts those
+		 * dependencies itself.
+		 */
+		crossxnu_kr = OSKextLoadKextWithIdentifier("com.apple.filesystems.apfs");
+		bsd_init_kprintf("crossxnu: OSKextLoadKextWithIdentifier("
+		    "com.apple.filesystems.apfs) -> %d\n", crossxnu_kr);
+	}
+
+#ifdef CROSSXNU_SECURITY_PERMISSIVE
+	/*
+	 * crossxnu: the APFS volume is mounted after IOKitBSDInit() below, not
+	 * here: its /dev node is created by an IOMedia BSD client, and those
+	 * only match once the IOBSD resource has been published.
+	 */
+#endif /* CROSSXNU_SECURITY_PERMISSIVE */
+
 #if 0 /* not yet */
 	consider_zone_gc(FALSE);
 #endif
@@ -1131,7 +1290,21 @@ bsd_autoconf(void)
 		}
 	}
 
+#ifdef CROSSXNU_SECURITY_PERMISSIVE
+	{
+		kern_return_t bsdinit_kr = IOKitBSDInit();
+
+		/*
+		 * IOBSD exists now, so the media BSD clients can match and the
+		 * APFS volume's /dev node appears; that cascade is not
+		 * synchronous, hence the polling inside the helper.
+		 */
+		crossxnu_mount_apfs_volume();
+		return bsdinit_kr;
+	}
+#else /* !CROSSXNU_SECURITY_PERMISSIVE */
 	return IOKitBSDInit();
+#endif
 }
 
 
