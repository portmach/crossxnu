+static inline void
+crossxnu_sched_log(uint32_t ev, uint32_t tid, uint32_t a, uint32_t b, uint32_t c, uint32_t d)
+{
+	unsigned int i = crossxnu_sched_ring_next & CROSSXNU_SCHED_RING_MASK;
+	struct crossxnu_sched_entry *e = &crossxnu_sched_ring[i];
