 		return KERN_FAILURE;
 	}
 }
+
+/*
+ * crossxnu: temporary bring-up diagnostic (see pthread_workqueue.c).
+ *
+ * Dumps the scheduler state of every thread of a process.  Called from a
+ * delayed thread call when pid 1 stops making progress, to name the blocking
+ * primitive through the kernel continuation each thread is parked in.
+ */
+void crossxnu_threads_dump(struct proc *p, const char *where);
+
+void
+crossxnu_threads_dump(struct proc *p, const char *where)
+{
+	task_t task = proc_task(p);
+	thread_t th;
+	uint64_t tids[24];
+	uint16_t tags[24];
+	int states[24];
+	uint32_t opts[24];
+	uintptr_t conts[24];
+	uint64_t evs[24];
+	uint64_t sysu[24], sysm[24], csw[24];
+	int n = 0, i;
+
+	if (task == NULL) {
+		return;
+	}
+
+	task_lock(task);
+	queue_iterate(&task->threads, th, thread_t, task_threads) {
+		if (n >= 24) {
+			break;
+		}
+		tids[n] = thread_tid(th);
+		tags[n] = thread_get_tag(th);
+		states[n] = th->state;
+		opts[n] = th->options;
+		conts[n] = (uintptr_t)th->continuation;
+		evs[n] = (uint64_t)th->wait_event;
+		sysu[n] = th->syscalls_unix;
+		sysm[n] = th->syscalls_mach;
+		csw[n] = th->c_switch;
+		n++;
+	}
+	task_unlock(task);
+
+	printf("crossxnu: threads(%s): pid=%d n=%d\n", where, proc_getpid(p), n);
+	for (i = 0; i < n; i++) {
+		/*
+		 * Kernel addresses are printed as two 32-bit halves: printf()
+		 * replaces any value that looks like a kernel pointer with
+		 * "<ptr>" when the output goes to a log.
+		 */
+		printf("crossxnu: threads(%s):  tid=%llu tag=0x%x state=0x%x opt=0x%x "
+		    "cont=%08x%08x ev=%08x%08x sys=%llu/%llu cs=%llu\n",
+		    where, (unsigned long long)tids[i], tags[i], states[i], opts[i],
+		    (unsigned)(conts[i] >> 32), (unsigned)conts[i],
+		    (unsigned)(evs[i] >> 32), (unsigned)evs[i],
+		    (unsigned long long)sysu[i], (unsigned long long)sysm[i],
+		    (unsigned long long)csw[i]);
+	}
+}
