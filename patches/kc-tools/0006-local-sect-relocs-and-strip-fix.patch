diff --git a/lib/linker.c b/lib/linker.c
index 70d7008..76e1b24 100644
--- a/lib/linker.c
+++ b/lib/linker.c
@@ -1312,7 +1312,14 @@ int link_kext(const uint8_t *kext_data, size_t kext_size,
           switch (r.r_type) {
           case X86_64_RELOC_UNSIGNED: {
             uint64_t addend = r64(loc);
-            w64(loc, target + addend);
+            /*
+             * The stored value is an absolute vmaddr in the image's own
+             * address space (the image is linked at vmbase 0), so a local
+             * reference only needs the placement slide.  Adding the target
+             * section address on top corrupts it, which broke __kalloc_type
+             * names and OSMetaClass strings.
+             */
+            w64(loc, r.r_extern ? target + addend : addend + load_vmaddr);
             break;
           }
           case X86_64_RELOC_BRANCH:
diff --git a/lib/prelink.c b/lib/prelink.c
index 0d14fa5..8cd0bfb 100644
--- a/lib/prelink.c
+++ b/lib/prelink.c
@@ -95,6 +95,8 @@ int prelink_assemble(const uint8_t *kernel_data, size_t kernel_size,
     if (k->info_plist_xml && k->info_plist_len)
       dict = plist_parse(k->info_plist_xml, k->info_plist_len);
     if (!dict || dict->type != PLIST_DICT) {
+      fprintf(stderr, "  INFO PARSE FAIL: %s (len %zu, type %d)\n",
+              k->bundle_path, k->info_plist_len, dict ? (int)dict->type : -1);
       if (dict) plist_free(dict);
       dict = plist_new_dict();
     }
diff --git a/src/kc_builder.c b/src/kc_builder.c
index aa88898..4a18299 100644
--- a/src/kc_builder.c
+++ b/src/kc_builder.c
@@ -166,8 +166,11 @@ strip_executable_key(char *xml, size_t len, size_t *out_len)
   char *e = strstr(s, "</string>");
   if (!e) { *out_len = len; return xml; }
   e += strlen("</string>");
-  memmove(s, e, len - (size_t)(e - xml));
-  *out_len = len - (size_t)(e - s);
+  /* Remove the key too: starting the move at the string would leave a
+   * dangling <key>CFBundleExecutable</key> and the plist parser stops
+   * there, silently dropping every following key. */
+  memmove(p, e, len - (size_t)(e - xml));
+  *out_len = len - (size_t)(e - p);
   return xml;
 }
 
