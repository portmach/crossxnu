--- a/src/kc_builder.c
+++ b/src/kc_builder.c
@@ -142,6 +142,35 @@ static void usage(const char *prog) {
 
 #define MAX_KEXTS 64
 
+
+/* Codeless entries have no executable, but their Info.plist still declares
+ * CFBundleExecutable.  OSKext then considers the kext executable and calls
+ * kext_get_vm_map() with a NULL kmod_info (crash at 0x9c), so drop the key. */
+static char *
+strip_executable_key(char *xml, size_t len, size_t *out_len)
+{
+  const char *needle = "<key>CFBundleExecutable</key>";
+  char *p = strstr(xml, needle);
+  if (!p) { *out_len = len; return xml; }
+  char *s = strstr(p, "<string>");
+  if (!s) { *out_len = len; return xml; }
+  /* Only strip when the key is immediately followed by its string value;
+   * otherwise the next <string> belongs to another key and removing it
+   * would corrupt the plist (this broke the com.apple.kpi.* entries). */
+  for (char *q = p + strlen(needle); q < s; q++) {
+    if (*q != ' ' && *q != '\t' && *q != '\n' && *q != '\r') {
+      *out_len = len;
+      return xml;
+    }
+  }
+  char *e = strstr(s, "</string>");
+  if (!e) { *out_len = len; return xml; }
+  e += strlen("</string>");
+  memmove(s, e, len - (size_t)(e - xml));
+  *out_len = len - (size_t)(e - s);
+  return xml;
+}
+
 int main(int argc, char *argv[]) {
   const char *kernel_path = NULL;
   const char *output_path = NULL;
