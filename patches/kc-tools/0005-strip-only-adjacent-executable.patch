+  if (!s || !e) {
+    *out_len = len;
+    return xml;
+  }
+  e += strlen("</string>");
+  memmove(s, e, len - (size_t)(e - xml));
+  *out_len = len - (size_t)(e - s);
+  return xml;
+}
