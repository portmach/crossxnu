+      // cause far from the missing kext, so stop and let the caller fix the set.
+      fprintf(stderr, "error: %s cannot be linked (%s); aborting\n",
+              kb->id, kb->bundle_path);
+      return 1;
+    }
+    if (lrc != 0) {
