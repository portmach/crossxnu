+  // arm64e slice first, and an arm64-only kext must be a build error rather
+  // than a kernel collection that traps on the first call into it.
+  int32_t kernel_cputype = 0;
+  if (macho_cputype(kernel_data, kernel_size, &kernel_cputype) != 0) {
+    fprintf(stderr, "kernel: not a Mach-O\n");
+    return 1;
+  }
+  fprintf(stderr, "kernel cputype: 0x%x\n", (unsigned)kernel_cputype);
+
   SymTable ksyms = {0};
   if (symtab_build_from_macho(&ksyms, kernel_data, kernel_size) != 0) {
