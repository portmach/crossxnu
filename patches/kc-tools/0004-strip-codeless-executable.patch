 #define MAX_KEXTS 64
 
+/* A codeless entry has no executable, but the original Info.plist usually
+ * still declares CFBundleExecutable.  OSKext then treats the kext as one with
+ * an executable, and setVMAttributes() calls kext_get_vm_map() with a NULL
+ * kmod_info -> page fault at 0x9c.  Drop the key for codeless entries. */
+static char *
+strip_executable_key(char *xml, size_t len, size_t *out_len)
+{
+  const char *needle = "<key>CFBundleExecutable</key>";
+  char *p = strstr(xml, needle);
+  if (!p) {
+    *out_len = len;
+    return xml;
+  }
+  char *s = strstr(p, "<string>");
+  char *e = s ? strstr(s, "</string>") : NULL;
+  if (!s || !e) {
+    *out_len = len;
+    return xml;
+  }
+  e += strlen("</string>");
+  memmove(s, e, len - (size_t)(e - xml));
+  *out_len = len - (size_t)(e - s);
+  return xml;
+}
