+{
+}
+
+void
+load_static_trust_cache(void)
+{
+}
+
+kern_return_t
+static_trust_cache_capabilities(
+	uint32_t *num_static_trust_caches_ret,
+	TCCapabilities_t *capabilities0_ret,
+	TCCapabilities_t *capabilities1_ret)
+{
+	if (num_static_trust_caches_ret != NULL) {
+		*num_static_trust_caches_ret = 0;
+	}
+	if (capabilities0_ret != NULL) {
+		*capabilities0_ret = 0;
+	}
+	if (capabilities1_ret != NULL) {
+		*capabilities1_ret = 0;
+	}
+	return KERN_SUCCESS;
+}
+
+kern_return_t
+check_trust_cache_runtime_for_uuid(
+	__unused const uint8_t check_uuid[kUUIDSize])
+{
+	return KERN_SUCCESS;
+}
+
+kern_return_t
+unload_trust_cache(__unused uuid_t uuid)
+{
+	return KERN_SUCCESS;
+}
+
+kern_return_t
+load_trust_cache(
+	__unused const uint8_t *img4_object, __unused const size_t img4_object_len,
+	__unused const uint8_t *img4_ext_manifest, __unused const size_t img4_ext_manifest_len)
+{
+	return KERN_SUCCESS;
+}
