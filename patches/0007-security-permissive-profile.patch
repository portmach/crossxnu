+	__unused TCQueryType_t query_type,
+	__unused const uint8_t cdhash[kTCEntryHashSize],
+	TrustCacheQueryToken_t *query_token)
+{
+	if (query_token != NULL) {
+		*query_token = (TrustCacheQueryToken_t){ 0 };
+	}
+	return KERN_SUCCESS;
+}
+
+kern_return_t
+query_trust_cache_for_rem(
+	__unused const uint8_t cdhash[kTCEntryHashSize],
+	__unused uint8_t *rem_perms)
+{
+	return KERN_NOT_SUPPORTED;
+}
+
+#else /* !CROSSXNU_SECURITY_PERMISSIVE */
+
