+
+/*
+ * crossxnu permissive TrustCache implementation.
+ *
+ * The real file below talks to AMFI and interprets libTrustCache objects.
+ * In permissive mode we deliberately do neither: every public entry point
+ * answers "success" without touching AMFI.  This keeps the kernel ABI and
+ * the trust-cache KPI, while making trust a no-op.
+ */
+
+#include <sys/cdefs.h>
