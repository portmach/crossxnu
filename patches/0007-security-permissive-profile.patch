diff --git a/bsd/kern/kern_codesigning.c b/bsd/kern/kern_codesigning.c
index 43a6b20..cd8487b 100644
--- a/bsd/kern/kern_codesigning.c
+++ b/bsd/kern/kern_codesigning.c
@@ -150,6 +150,20 @@ code_signing_configuration(
 	config |= CS_CONFIG_LOCAL_SIGNING;
 	config |= CS_CONFIG_OOP_JIT;
 
+#if CROSSXNU_SECURITY_PERMISSIVE
+	/*
+	 * crossxnu phase 1: keep the cs_* ABI, cs_blob parsing and
+	 * entitlements parser, but do not enforce signatures or entitlements.
+	 * This is a security policy, not an ABI change.
+	 */
+	config |= CS_CONFIG_ALLOW_ANY_SIGNATURE;
+	config |= CS_CONFIG_ENFORCEMENT_DISABLED;
+	config |= CS_CONFIG_GET_OUT_OF_MY_WAY;
+	config |= CS_CONFIG_INTEGRITY_SKIP;
+	config |= CS_CONFIG_UNRESTRICTED_DEBUGGING;
+	printf("crossxnu: permissive code-signing profile enabled\n");
+#endif
+
 #if CODE_SIGNING_MONITOR
 	/* Mark the code signing monitor as enabled if required */
 	if (csm_enabled() == true) {
