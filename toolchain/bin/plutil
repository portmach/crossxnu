#!/usr/bin/env python3
"""Minimal plutil(1) replacement for XNU's build scripts.

Supports:
  plutil -lint -s FILE
  plutil -convert binary1 -s FILE
  plutil -convert xml1 -s FILE
"""
import plistlib
import sys


def main(argv):
    args = argv[1:]
    mode = None
    convert = None
    files = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "-lint":
            mode = "lint"
            i += 1
        elif a == "-convert":
            mode = "convert"
            convert = args[i + 1]
            i += 2
        elif a in ("-s", "-silent"):
            i += 1
        elif a.startswith("-"):
            # Ignore unknown plutil flags; XNU only uses the subset above.
            i += 1
        else:
            files.append(a)
            i += 1

    if not files:
        return 0

    for path in files:
        try:
            with open(path, "rb") as f:
                value = plistlib.load(f)
        except Exception as exc:  # noqa: BLE001 - report like plutil
            print(f"plutil: {path}: {exc}", file=sys.stderr)
            return 1

        if mode == "convert":
            fmt = plistlib.FMT_BINARY if convert == "binary1" else plistlib.FMT_XML
            with open(path, "wb") as f:
                plistlib.dump(value, f, fmt=fmt, sort_keys=False)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
