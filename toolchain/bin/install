#!/usr/bin/env bash
# BSD install(1) compatibility wrapper for XNU's build system.
set -euo pipefail

args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|-S) shift ;;
        -o|-g) shift 2 ;;
        -m) args+=("-m" "$2"); shift 2 ;;
        -m*) args+=("$1"); shift ;;
        -d) args+=("-d"); shift ;;
        *) args+=("$1"); shift ;;
    esac
done

exec /usr/bin/install "${args[@]}"
