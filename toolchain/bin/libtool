#!/usr/bin/env bash
# Apple libtool replacement.
#
# XNU uses libtool only to create static archives:
#   libtool -static -csD -filelist FILE [-o OUT] [extra.o ...]
#   libtool -ca [files...] -filelist FILE -o OUT
# llvm-libtool-darwin covers a subset but rejects -csD/-ca, so we map the
# operation to llvm-ar in Darwin (BSD) archive format.
set -euo pipefail

AR="${CROSSXNU_AR:-/usr/bin/llvm-ar}"
out=""
files=()
filelist=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -static|-D|-c|-s|-csD|-ca|-no_warning_for_no_symbols) shift ;;
        -filelist)  filelist="$2"; shift 2 ;;
        -o)         out="$2"; shift 2 ;;
        -o*)        out="${1#-o}"; shift ;;
        -L|-l)      shift 2 ;;
        -*)         shift ;;
        *)          files+=("$1"); shift ;;
    esac
done

if [[ -n "${filelist}" ]]; then
    while IFS= read -r line; do
        [[ -n "${line}" ]] && files+=("${line}")
    done < "${filelist}"
fi

if [[ -z "${out}" ]]; then
    echo "libtool: missing -o" >&2
    exit 2
fi
if [[ ${#files[@]} -eq 0 ]]; then
    echo "libtool: no input files for ${out}" >&2
    exit 2
fi

rm -f "${out}"
exec "${AR}" --format=darwin rcs "${out}" "${files[@]}"
